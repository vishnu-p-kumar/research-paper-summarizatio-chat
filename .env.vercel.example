# ============================================================
# Vercel Environment Variables
# Add these in Vercel -> Project -> Settings -> Environment Variables.
# Do not upload real secrets to GitHub.
# ============================================================

# Free-tier friendly database: Neon Postgres Free plan.
DATABASE_URL=PASTE_YOUR_DATABASE_URL_HERE

# Required for auth cookies/JWT. Generate with: openssl rand -hex 32
JWT_SECRET_KEY=PASTE_A_LONG_RANDOM_JWT_SECRET_HERE
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
RESET_TOKEN_EXPIRE_MINUTES=30
COOKIE_SECURE=1

# Replace your-app with your Vercel domain.
CORS_ORIGINS=https://your-app.vercel.app

# Google Gemini API key from Google AI Studio.
# Free-tier note: Gemini API may have a free quota with rate limits.
GEMINI_API_KEY=PASTE_YOUR_GEMINI_API_KEY_HERE
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
MODEL_NAME=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-3.1-flash-lite
GEMINI_MAX_TOKENS=800
GEMINI_TEMPERATURE=0.2

# Free/no-key web fallback, best-effort.
ENABLE_WEB_FALLBACK=1
WEB_MAX_RESULTS=3
WEB_TIMEOUT_S=12

# PostgreSQL-backed RAG.
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Keep small for Vercel serverless.
MAX_UPLOAD_MB=10
