# ============================================================
# Local Backend Environment
# Copy this file to backend/.env for local backend testing.
# Never commit backend/.env.
# ============================================================

# PostgreSQL connection string. Recommended free-tier option: Neon Postgres.
DATABASE_URL=PASTE_YOUR_DATABASE_URL_HERE_enter

# Auth secret. Generate with: openssl rand -hex 32
JWT_SECRET_KEY=PASTE_A_LONG_RANDOM_JWT_SECRET_HERE
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
RESET_TOKEN_EXPIRE_MINUTES=30

# Local development uses HTTP, so COOKIE_SECURE=0 locally.
COOKIE_SECURE=0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Google Gemini API key from Google AI Studio.
GEMINI_API_KEY=PASTE_YOUR_GEMINI_API_KEY_HERE
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
MODEL_NAME=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-3.1-flash-lite
GEMINI_MAX_TOKENS=800
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_RETRIES=3
GEMINI_RETRY_BACKOFF_S=2

# No paid API key required.
ENABLE_WEB_FALLBACK=1
WEB_MAX_RESULTS=3
WEB_TIMEOUT_S=12

# RAG settings.
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Upload limit.
MAX_UPLOAD_MB=10
