# ============================================================
# AI Research Paper Summarizer + Chat - Backend Environment
# Copy these values into Vercel Project Settings -> Environment Variables.
# For local backend testing, copy this file to backend/.env and fill values.
# Never commit real API keys, database passwords, or JWT secrets.
# ============================================================

# ------------------------------------------------------------
# PostgreSQL database
# Recommended free-tier option: Neon Postgres Free plan.
# Add your pooled connection string here.
# Example:
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# ------------------------------------------------------------
DATABASE_URL=PASTE_YOUR_DATABASE_URL_HERE

# ------------------------------------------------------------
# JWT authentication
# Required. Generate a long random secret.
# Example command:
#   openssl rand -hex 32
# ------------------------------------------------------------
JWT_SECRET_KEY=PASTE_A_LONG_RANDOM_JWT_SECRET_HERE
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
RESET_TOKEN_EXPIRE_MINUTES=30

# ------------------------------------------------------------
# Cookies
# Vercel uses HTTPS, so keep COOKIE_SECURE=1 in production.
# For local HTTP development only, set COOKIE_SECURE=0 in backend/.env.
# ------------------------------------------------------------
COOKIE_SECURE=1

# ------------------------------------------------------------
# CORS
# For Vercel, replace your-app with your real Vercel domain.
# For local dev, include localhost origins.
# ------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-app.vercel.app

# ------------------------------------------------------------
# Google Gemini API
# Required for summaries and chat.
# Free-tier note: Google AI Studio/Gemini API commonly offers a free tier
# with rate limits. Check your Google account quota before public use.
# ------------------------------------------------------------
GEMINI_API_KEY=PASTE_YOUR_GEMINI_API_KEY_HERE
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
MODEL_NAME=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-3.1-flash-lite
GEMINI_MAX_TOKENS=800
GEMINI_TEMPERATURE=0.2

# ------------------------------------------------------------
# Web fallback
# Uses DuckDuckGo HTML scraping. No paid API key required, best-effort only.
# ------------------------------------------------------------
ENABLE_WEB_FALLBACK=1
WEB_MAX_RESULTS=3
WEB_TIMEOUT_S=12

# ------------------------------------------------------------
# RAG settings
# Stored in PostgreSQL. Embeddings use deterministic hashing, so no paid
# embedding service and no local ML model download are required.
# ------------------------------------------------------------
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# ------------------------------------------------------------
# Upload limits
# Keep this modest for Vercel serverless request limits.
# ------------------------------------------------------------
MAX_UPLOAD_MB=10
