# ============================================================
# Frontend Environment
# Copy to frontend/.env.local for local frontend testing.
# ============================================================

# Local development:
# If FastAPI runs on localhost:8000, use this:
VITE_API_BASE_URL=http://localhost:8000

# Vercel deployment:
# Leave VITE_API_BASE_URL unset/empty when frontend and backend are deployed
# in the same Vercel project, because API calls use same-origin /api routes.
# VITE_API_BASE_URL=
